{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "vitest"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "vitest/no-identical-title": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "vitest/expect-expect": "error",
    "vitest/no-conditional-tests": "error",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    "no-restricted-properties": [
      "error",
      {
        "object": "vi",
        "property": "restoreAllMocks",
        "message": "Vitest already puts it back before each test (vite.config.ts): docs/TESTING.md → What a test puts in place outside its own tree."
      },
      {
        "object": "vi",
        "property": "unstubAllGlobals",
        "message": "Vitest already puts it back before each test (vite.config.ts): docs/TESTING.md → What a test puts in place outside its own tree."
      },
      {
        "object": "vi",
        "property": "unstubAllEnvs",
        "message": "Vitest already puts it back before each test (vite.config.ts): docs/TESTING.md → What a test puts in place outside its own tree."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/**/*.tsx"
      ],
      "excludeFiles": [
        "src/**/*.test.tsx",
        "src/test/**"
      ],
      "rules": {
        "react/jsx-no-literals": [
          "error",
          {
            "noStrings": true,
            "ignoreProps": true,
            "allowedStrings": [
              "",
              "·",
              "/",
              "—",
              "↓",
              "↑",
              "#",
              ","
            ],
            "restrictedAttributes": [
              "aria-label",
              "aria-description",
              "aria-roledescription",
              "aria-valuetext",
              "aria-placeholder",
              "title",
              "placeholder",
              "alt",
              "label",
              "subtitle",
              "heading",
              "hint",
              "help",
              "error",
              "message",
              "text",
              "dot",
              "actionLabel",
              "secondaryActionLabel",
              "editLabel"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "e2e/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "importNames": [
                  "default",
                  "test",
                  "expect",
                  "mergeExpects"
                ],
                "message": "Import test and expect from e2e/test.ts, whose toHaveScreenshot also reads the state with axe against its accessibility budget."
              },
              {
                "name": "playwright/test",
                "importNames": [
                  "default",
                  "test",
                  "expect",
                  "mergeExpects"
                ],
                "message": "Import test and expect from e2e/test.ts, whose toHaveScreenshot also reads the state with axe against its accessibility budget."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "e2e/test.ts",
        "e2e/smoke/**/*.ts",
        "e2e/performance/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "playwright/test",
                "message": "Import from @playwright/test, the package this project names."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "e2e/smoke/*.smoke.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "importNames": [
                  "test",
                  "expect"
                ],
                "message": "Import test and expect from ./test.ts, which fails a journey on anything the Content-Security-Policy blocks."
              }
            ]
          }
        ]
      }
    }
  ]
}
