{
  "coverage": {
    "include": ["src/**/*.{ts,tsx}", "server/**/*.ts", "tmdb-proxy/**/*.ts", "scripts/guard/**/*.ts", "scripts/size/**/*.ts"],
    "exclude": [
      "**/*.test.{ts,tsx}",
      "src/test/**",
      "src/test-setup.ts",
      "server/test/**",
      "**/*.d.ts",
      "**/types.ts",
      "src/api/*/index.ts",
      "src/components/*/index.ts"
    ],
    "thresholds": { "lines": 96, "statements": 95, "functions": 95, "branches": 93 }
  },
  "mutants": {
    "folders": ["src", "server", "tmdb-proxy", "scripts/guard", "scripts/size"],
    "notProduction": ["\\.test\\.tsx?$", "/test/", "\\.d\\.ts$", "^src/test-setup\\.ts$"],
    "excludedMutations": ["StringLiteral", "ArrayDeclaration", "ObjectLiteral", "OptionalChaining"]
  },
  "budgets": {
    "size": { "js": 194400, "css": 16200, "rest": 193600 }
  }
}
