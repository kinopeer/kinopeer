# Copy to .env.local and adjust. .env.local is git-ignored. The dev server (npm run dev), the
# production server (npm start) and docker compose all read these.

# qBittorrent Web UI address the server bridges /qbt to.
QBITTORRENT_URL=http://localhost:8080
# Optional default login. The server logs in itself and keeps the session; a login entered in the
# app (kept in $KINOPEER_DATA_DIR/settings.json) wins over these. Leave empty to enter it in the app,
# or for qBittorrent's auth bypass.
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Optional TMDB API key (v3) or read access token (v4) from themoviedb.org → Settings → API.
# Usually entered in the app instead (onboarding or Settings), which the server keeps in
# $KINOPEER_DATA_DIR/settings.json; a key saved there wins over this one. Never reaches the browser.
TMDB_API_KEY=
# Without a key, TMDB calls go to Kinopeer's TMDB proxy, which adds Kinopeer's key. Set this to use
# another one (the edge worker: https://kinopeer-tmdb-edge.kinoseed.workers.dev/3), or empty to turn
# it off, so the app asks for a key.
# TMDB_PROXY_URL=

# Prowlarr address and API key (Prowlarr → Settings → General → API Key). The server's
# /prowlarr routes search through it; the key never reaches the browser.
PROWLARR_URL=
PROWLARR_API_KEY=
# Or, instead of PROWLARR_API_KEY, the path to Prowlarr's config.xml to read the key from.
# PROWLARR_CONFIG_XML=

# Where the server keeps settings saved from the app (default ./data, /data in the Docker image).
# KINOPEER_DATA_DIR=
