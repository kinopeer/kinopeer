# Copy to .env.local and adjust. .env.local is git-ignored.

# qBittorrent Web UI address the dev server proxies /qbt to.
QBITTORRENT_URL=http://localhost:8080

# TMDB API key (v3) or read access token (v4) from themoviedb.org → Settings → API.
# The dev server adds it to /tmdb requests; it never reaches the browser.
TMDB_API_KEY=

# Prowlarr address and API key (Prowlarr → Settings → General → API Key). The dev server's
# /prowlarr routes search through it; the key never reaches the browser.
PROWLARR_URL=
PROWLARR_API_KEY=
