# Copy to .env.local and adjust. .env.local is git-ignored. The dev server (npm run dev) and the
# production server (npm start) read these. docker-compose.yml reads a .env of its own (README);
# the dev server reads a .env in the checkout too, git-ignored as well, so its KINOPEER_PASSWORD
# applies there.

# qBittorrent Web UI address the server bridges /qbt to. Without it, the app asks for one on its
# connect screen and Settings changes it (with Kinopeer's own login on, below), and the server keeps
# it; set here, it wins.
QBITTORRENT_URL=http://localhost:8080
# Optional default login; qBittorrent's auth bypass needs none, and without these the app asks for
# one. The server logs in itself and keeps the session; a login entered in the app (kept in
# $KINOPEER_DATA_DIR/settings.json) wins over these. Used only with QBITTORRENT_URL: never sent to
# an address saved from the app.
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Optional TMDB API key (v3) or read access token (v4) from themoviedb.org → Settings → API.
# Development needs none: without a key, TMDB calls go to Kinopeer's TMDB proxy (below), whose edge
# worker the dev server and the README screenshots use. A branch that adds a TMDB path needs a key
# (or TMDB_PROXY_URL at a local `wrangler dev`) until it merges: the edge worker answers 404 for a
# path it hasn't deployed. A key can also be entered in the app
# (onboarding or Settings), which the server keeps in $KINOPEER_DATA_DIR/settings.json; a key saved
# there wins over this one. Never reaches the browser.
TMDB_API_KEY=
# Without a key, TMDB calls go to Kinopeer's TMDB proxy, which adds Kinopeer's key. Set this to use
# another one (the edge worker: https://tmdb-edge.kinopeer.com/3), or empty to turn
# it off, so the app asks for a key. `npm run build:webui` bakes this one (or KINOPEER_TMDB_PROXY) into
# the WebUI bundle at build time: the release worker by default, not the dev server's edge worker.
# TMDB_PROXY_URL=

# Prowlarr address and API key (Prowlarr → Settings → General → API Key). The server's
# /prowlarr routes search through it; the key never reaches the browser. Without an address, the
# app asks for both in onboarding or Settings (with Kinopeer's own login on); set here, the address wins. The
# key, here or from PROWLARR_CONFIG_XML, is used only with PROWLARR_URL: never sent to an address
# saved from the app.
PROWLARR_URL=
PROWLARR_API_KEY=
# Or, instead of PROWLARR_API_KEY, the path to Prowlarr's config.xml to read the key from.
# PROWLARR_CONFIG_XML=

# Host names the server answers at besides IP addresses, localhost, *.local, *.onion, *.home.arpa,
# *.internal and names of one label (a LAN name), which no public DNS answers for: a reverse proxy's
# domain, say. Names or domains of your own (.example.com, every name under it: two labels or more,
# and not a shared dynamic DNS or hosting domain such as .duckdns.org, where anyone can register a
# name; for a one-label suffix such as .lan, list the names: kinopeer.lan), separated by commas or spaces;
# * answers at any name. Keeps a website that points its own name at Kinopeer's address (DNS
# rebinding) from reaching it. A reverse proxy in front must pass the name the page was opened at:
# keep Host (nginx: proxy_set_header Host $host) or send X-Forwarded-Host. nginx's default sends
# its upstream's address and no X-Forwarded-Host, so the check sees only that.
# KINOPEER_ALLOWED_HOSTS=kinopeer.example.com

# Where the server keeps settings saved from the app (default ./data, /data in the Docker image).
# KINOPEER_DATA_DIR=

# Kinopeer's own login: on by default, so the first visitor sets a password. Set it to off only where
# something in front of Kinopeer asks for a login (the Umbrel package does: Umbrel's login is in
# front). Any value but on or off stops the server.
# KINOPEER_AUTH=
# Kinopeer's password, in place of one set in the app, which can't change it then: 8 to 256
# characters, else the server doesn't start. Changing it signs every browser out. Kept only as a
# hash, in $KINOPEER_DATA_DIR/auth.json.
# KINOPEER_PASSWORD=
