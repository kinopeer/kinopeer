# Copy to .env.local and adjust. .env.local is git-ignored. The dev server (npm run dev), the
# production server (npm start) and docker compose all read these.

# qBittorrent Web UI address the server bridges /qbt to.
QBITTORRENT_URL=http://localhost:8080
# Optional: with these the server logs in to qBittorrent itself and keeps the session, so the
# app never asks for a password. Leave empty to sign in from the app (or for qBittorrent's auth bypass).
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# TMDB API key (v3) or read access token (v4) from themoviedb.org → Settings → API.
# The server adds it to /tmdb requests; it never reaches the browser.
TMDB_API_KEY=

# Prowlarr address and API key (Prowlarr → Settings → General → API Key). The server's
# /prowlarr routes search through it; the key never reaches the browser.
PROWLARR_URL=
PROWLARR_API_KEY=
