// Kinopeer's TMDB proxy on Cloudflare Workers (docs/DEVELOPMENT.md → The TMDB proxy), as two workers
// that follow the builds calling them: `edge` goes out with every Kinopeer Edge build, `release` with
// every release (.github/workflows/tmdb-proxy.yml). The key is each worker's secret TMDB_API_KEY,
// never in this file. Each environment declares all of its settings, since bindings aren't inherited.
//
// - cache: Workers Cache in front of the worker keeps TMDB's answers by the worker's Cache-Control
//   and runs it only on a miss. Unlike the Cache API, it works on workers.dev too. Shared across worker
//   versions, since every edge build deploys one and a cold cache each time would send every call
//   to TMDB; a change to what an answer looks like reaches cached ones within their time, a day.
// - observability off: no request logs, since the proxy sees each install's IP and its searches.
// - ratelimits: the calls that reach TMDB, per IP and Cloudflare location. 100 in 10 seconds covers
//   Downloads guessing the titles of a long list (three searches at a time) and stops a script from
//   pulling TMDB through Kinopeer's key. Each worker has its own namespace, so they count apart.
// - routes: each worker answers on its own name under kinopeer.com (a Custom Domain, which Cloudflare
//   gives a DNS record and a certificate) and not on workers.dev, so the address released versions
//   call doesn't depend on the Cloudflare account's name. Kinoseed's workers (kinoseed-tmdb and
//   kinoseed-tmdb-edge, namespaces 1001 and 1002) are no longer in this file: versions up to 0.7
//   call them on workers.dev, and they stay deployed as they are until no one does.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The top level is for `wrangler dev` alone: a deploy without `--env` makes a worker of this name,
  // which installs don't call, rather than replacing the release worker.
  "name": "kinopeer-tmdb-local",
  "main": "worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "cache": { "enabled": true, "cross_version_cache": true },
  "observability": { "enabled": false },
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1003", "simple": { "limit": 100, "period": 10 } }],
  "env": {
    "edge": {
      "name": "kinopeer-tmdb-edge",
      "workers_dev": false,
      "routes": [{ "pattern": "tmdb-edge.kinopeer.com", "custom_domain": true }],
      "cache": { "enabled": true, "cross_version_cache": true },
      "observability": { "enabled": false },
      "ratelimits": [{ "name": "LIMITER", "namespace_id": "1005", "simple": { "limit": 100, "period": 10 } }]
    },
    "release": {
      "name": "kinopeer-tmdb",
      "workers_dev": false,
      "routes": [{ "pattern": "tmdb.kinopeer.com", "custom_domain": true }],
      "cache": { "enabled": true, "cross_version_cache": true },
      "observability": { "enabled": false },
      "ratelimits": [{ "name": "LIMITER", "namespace_id": "1004", "simple": { "limit": 100, "period": 10 } }]
    }
  }
}
