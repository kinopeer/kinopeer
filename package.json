{
  "name": "kinopeer",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutants": "node scripts/mutants.mjs",
    "guard": "node scripts/guard/guard.ts",
    "typecheck": "tsc -b",
    "test:visual": "scripts/test-visual.sh",
    "test:visual:update": "scripts/test-visual.sh --update-snapshots",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "screenshots:readme": "scripts/readme-screenshots.sh"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-router": "^8.5.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
